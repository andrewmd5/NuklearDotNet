<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Nullable>enable</Nullable>
    <RootNamespace>NuklearDotNet</RootNamespace>
    <AssemblyName>NuklearDotNet</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <!-- This project is the managed binding only. Applications that consume the
         native library opt into UseNuklear and copy/build Nuklear2 themselves. -->
  </PropertyGroup>
</Project>
